# Kyriba Treasury Management System
KYRIBA_MODE=mock
# Real-mode credentials (only used when KYRIBA_MODE=real)
KYRIBA_BASE_URL=https://api.kyriba.com
KYRIBA_TOKEN_URL=https://api.kyriba.com/oauth/token
KYRIBA_CLIENT_ID=
KYRIBA_CLIENT_SECRET=

# Bank connectivity
BANK_MODE=mock
BANK_FILE_OUTBOX=./outbox

# Database: default SQLite for local runs. Switch to Postgres like so:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/treasury
DATABASE_URL=sqlite:///./treasury.db

DEFAULT_CURRENCY=USD
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
